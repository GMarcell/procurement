# ─── Procura — Environment Variables ────────────────────────────────────────
# Copy to `.env` and fill in the values:
#   cp .env.example .env

# PostgreSQL connection string. The app expects its own database.
DATABASE_URL="postgresql://procurement:procurement@127.0.0.1:5435/procurement"

# Secret used by NextAuth to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Include this when running behind a proxy or on localhost.
AUTH_TRUST_HOST="true"
