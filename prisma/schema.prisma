// Procura — procure-to-pay data model.
// One company, three roles, one vendor per request, one payment request per PO.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  APPROVER
  ADMIN
}

enum RequestStatus {
  SUBMITTED
  APPROVED
  ASSIGNED
  ORDERED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
}

enum DeliveryCondition {
  GOOD
  DAMAGED
  PARTIAL
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(REQUESTER)
  createdAt DateTime @default(now())

  requests         PurchaseRequest[]  @relation("RequestRequester")
  approvedRequests PurchaseRequest[]  @relation("RequestApprover")
  assignedRequests PurchaseRequest[]  @relation("RequestAssigner")
  createdOrders    PurchaseOrder[]    @relation("OrderCreator")
  approvedOrders   PurchaseOrder[]    @relation("OrderApprover")
  requestedPayments PaymentRequest[]  @relation("PaymentRequester")
  approvedPayments  PaymentRequest[]  @relation("PaymentApprover")
  receipts         GoodsReceipt[]     @relation("ReceiptRecorder")
  movements        InventoryMovement[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  category    String
  unit        String   @default("pcs")
  unitPrice   Decimal  @db.Decimal(12, 2)
  stockQty    Int      @default(0)
  minStock    Int      @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requestItems PurchaseRequestItem[]
  orderItems   PurchaseOrderItem[]
  movements    InventoryMovement[]

  @@index([category])
  @@index([name])
}

model Vendor {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  paymentTerms String   @default("NET 30")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests PurchaseRequest[]
  orders   PurchaseOrder[]

  @@index([name])
}

model PurchaseRequest {
  id           String        @id @default(cuid())
  number       String        @unique
  requesterId  String
  requester    User          @relation("RequestRequester", fields: [requesterId], references: [id])
  department   String
  purpose      String
  neededBy     DateTime?
  status       RequestStatus @default(SUBMITTED)
  notes        String?

  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorNote String?
  assignedById String?
  assignedBy   User?     @relation("RequestAssigner", fields: [assignedById], references: [id])
  assignedAt   DateTime?

  approvedById   String?
  approvedBy     User?     @relation("RequestApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  PurchaseRequestItem[]
  orders PurchaseOrder[]

  @@index([status])
  @@index([requesterId])
  @@index([createdAt])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  estimatedUnitPrice Decimal        @db.Decimal(12, 2)

  @@index([purchaseRequestId])
}

model PurchaseOrder {
  id                String      @id @default(cuid())
  number            String      @unique
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])

  // A request keeps its order history: rejected orders stay visible while
  // procurement creates a replacement. The newest order is the active one.
  vendorId          String
  vendor            Vendor      @relation(fields: [vendorId], references: [id])
  createdById       String
  createdBy         User        @relation("OrderCreator", fields: [createdById], references: [id])
  status            OrderStatus @default(PENDING)
  orderDate         DateTime    @default(now())
  expectedDate      DateTime?
  subtotal          Decimal     @db.Decimal(12, 2)
  total             Decimal     @db.Decimal(12, 2)
  notes             String?

  approvedById    String?
  approvedBy      User?     @relation("OrderApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    PurchaseOrderItem[]
  payments PaymentRequest[]
  receipts GoodsReceipt[]

  @@index([status])
  @@index([vendorId])
  @@index([purchaseRequestId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  receivedQty     Int           @default(0)

  receiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model PaymentRequest {
  id         String        @id @default(cuid())
  number     String        @unique
  // Rejected attempts stay in the history; a replacement can be raised.
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  dueDate    DateTime?
  method     PaymentMethod @default(BANK_TRANSFER)
  status     PaymentStatus @default(PENDING)
  notes      String?

  requestedById String
  requestedBy   User   @relation("PaymentRequester", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?  @relation("PaymentApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectionReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String            @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  receivedDate    DateTime          @default(now())
  receivedBy      String
  deliveryNoteNo  String?
  condition       DeliveryCondition @default(GOOD)
  notes           String?
  proofUrl        String?

  recordedById String
  recordedBy   User   @relation("ReceiptRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  items GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id                 String            @id @default(cuid())
  goodsReceiptId     String
  goodsReceipt       GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem  PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  quantity           Int

  @@index([goodsReceiptId])
}

model InventoryMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  type      MovementType
  quantity  Int
  reference String?
  note      String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}
